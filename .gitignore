# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
.coverage.*
.tox/
# htmlcov/ is intentionally committed as a browsable coverage report

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local sprite-prep tooling (not part of the project)
slice_sprites.py
remove_background.py

# Local SQLite databases
accounts.db
history.db

# Runtime activity logs (server/client)
*.log

# Self-signed dev TLS cert/key (scripts/generate_dev_cert.py) - never commit
# a private key, even a throwaway local one.
certs/
